{
  "target": {
    "repoPath": "../shop",
    "githubRepo": "acme/shop",
    "baseBranch": "main",
    "brain": ["README.md", "docs/"],
    "readOnlyPaths": []
  },
  "intake": { "label": "factory" },
  "checks": {
    "commands": ["npm ci", "npm run typecheck", "npm run test"],
    "timeoutMinutes": 20
  },
  "specWriter": { "model": "claude-opus-5-5", "effort": "high", "maxTurns": 30 },
  "builder": {
    "model": "claude-opus-5-5",
    "effort": "high",
    "maxTurns": 80,
    "allowedBash": ["Bash(npm ci)", "Bash(npm run typecheck:*)", "Bash(npm run test:*)", "Bash(git status:*)", "Bash(git diff:*)"]
  },
  "reviewers": {
    "security": { "model": "claude-sonnet-5-5", "effort": "high", "maxTurns": 20 },
    "ux": { "model": "claude-sonnet-5-5", "effort": "medium", "maxTurns": 20 },
    "ui": { "model": "claude-sonnet-5-5", "effort": "medium", "maxTurns": 20 },
    "code": { "model": "claude-sonnet-5-5", "effort": "medium", "maxTurns": 20 }
  },
  "limits": { "maxRounds": 3, "maxCostUsd": 15 },
  "risk": {
    "maxLowRiskChangedLines": 300,
    "testPathPatterns": ["**/*.test.*", "test/**"],
    "highRiskPaths": [
      { "pattern": "package.json", "reason": "dependencies and scripts" },
      { "pattern": "package-lock.json", "reason": "dependencies" },
      { "pattern": "src/db/**", "reason": "persistence layer" },
      { "pattern": "src/auth/**", "reason": "authentication" },
      { "pattern": "**/migrations/**", "reason": "database migrations" },
      { "pattern": ".github/**", "reason": "CI/workflows" }
    ]
  }
}
